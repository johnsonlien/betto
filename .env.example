DATABASE_URL="postgresql://user:password@localhost:5432/betto"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Must match the address you actually load the app from (e.g. a LAN IP if
# accessing from another device) — Auth.js uses this to build magic-link and
# callback URLs. Not needed if you only ever use http://localhost:3000.
AUTH_URL="http://localhost:3000"

# Resend (magic-link + invite emails) — get a key at https://resend.com
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="Betto <onboarding@resend.dev>"

# Dev only: every request auto-signs-in as this user (no login needed) as
# long as NODE_ENV isn't "production". Change to test as a different user.
DEV_USER_EMAIL="dev@localhost"
