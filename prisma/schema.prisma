generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CollaboratorRole {
  OWNER
  EDITOR
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  ownedCalendars    Calendar[]             @relation("CalendarOwner")
  collaborations    CalendarCollaborator[]
  invitesSent       CalendarInvite[]       @relation("InvitesSent")
  shareLinksCreated CalendarShareLink[]    @relation("ShareLinksCreated")
}

// Auth.js (NextAuth) Prisma adapter models.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Calendar {
  id        String   @id @default(cuid())
  title     String
  startDate DateTime
  endDate   DateTime
  // Per-category hex color overrides, e.g. {"FOOD": "#f97316"}; categories
  // not present fall back to the built-in default palette
  // (components/calendar/category.ts). Shared by everyone viewing the
  // calendar, not per-viewer.
  categoryColors Json?
  createdAt      DateTime @default(now())

  ownerId String
  owner   User   @relation("CalendarOwner", fields: [ownerId], references: [id])

  collaborators CalendarCollaborator[]
  events        Event[]
  locations     Location[]
  invites       CalendarInvite[]
  shareLinks    CalendarShareLink[]
}

model CalendarCollaborator {
  id        String           @id @default(cuid())
  role      CollaboratorRole @default(EDITOR)
  createdAt DateTime         @default(now())

  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([calendarId, userId])
}

enum EventCategory {
  LODGING
  FOOD
  ACTIVITY
  TRANSPORT
  OTHER
}

model Event {
  id        String         @id @default(cuid())
  title     String
  notes     String?
  // null date = an unscheduled "idea pool" event, not yet assigned a day.
  // Pool events never have a startTime/endTime either.
  date      DateTime?
  startTime DateTime?
  endTime   DateTime?
  position  Int
  category  EventCategory?
  // Optional cost for the event (e.g. a reservation price); no currency
  // field yet — assumed to be the trip's single implied currency.
  cost      Decimal?       @db.Decimal(10, 2)
  // Optional link to a reservation/booking confirmation (hotel, restaurant,
  // flight, etc.) — a bare URL, not a structured reservation record.
  reservationUrl String?
  createdAt DateTime       @default(now())

  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  @@index([calendarId, date])
}

// Targeted invite: a specific email, one pending invite per (calendar, email).
// Only EDITOR or VIEWER should be used here — ownership isn't transferred via invite.
model CalendarInvite {
  id        String           @id @default(cuid())
  email     String
  role      CollaboratorRole @default(VIEWER)
  status    InviteStatus     @default(PENDING)
  token     String           @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime         @default(now())

  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("InvitesSent", fields: [invitedById], references: [id])

  @@unique([calendarId, email])
}

// Generic shareable link for a role. At most one active (non-revoked) link
// per (calendar, role) should exist — enforced in application logic when
// regenerating, since Prisma/Postgres partial unique indexes aren't modeled here.
// VIEWER links grant read-only access with no account required; EDITOR links
// require sign-in (account creation if needed) before granting access.
model CalendarShareLink {
  id        String           @id @default(cuid())
  role      CollaboratorRole @default(VIEWER)
  token     String           @unique @default(cuid())
  revokedAt DateTime?
  createdAt DateTime         @default(now())

  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ShareLinksCreated", fields: [createdById], references: [id])
}

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String?
  // Best-effort city extracted from the geocoder at pin-creation time (used
  // to aggregate "which cities today's/this week's/this month's events are
  // in"); null for locations created before this existed or without a
  // resolvable city.
  city      String?
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  events Event[]
}
